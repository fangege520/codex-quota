{
  "name": "codex-quota-overlay",
  "version": "0.4.2",
  "private": true,
  "description": "Cross-platform Codex quota overlay",
  "license": "MIT",
  "author": "fangege520",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/quota.test.cjs tests/transport.test.cjs tests/composer.test.cjs tests/desktop-app.test.cjs tests/runtime.test.cjs tests/system-bar.test.cjs tests/usage.test.cjs",
    "check": "node scripts/manage.cjs check",
    "smoke": "node scripts/smoke.cjs",
    "test:composer": "node scripts/test-composer.cjs"
  },
  "devDependencies": {
    "electron": "45.2.1"
  },
  "build": {
    "appId": "io.github.fangege520.codex-quota",
    "productName": "Codex Quota",
    "artifactName": "Codex-Quota-${version}-${os}-${arch}.${ext}",
    "files": [
      "desktop/**/*",
      "lib/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "icon": "assets/icon.png",
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "zip",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false
    },
    "asar": true,
    "asarUnpack": [
      "lib/*.ps1",
      "lib/stop-mac-app.js"
    ]
  }
}
